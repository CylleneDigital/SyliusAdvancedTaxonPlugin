{% import '@SyliusAdmin/shared/helper/translations.html.twig' as translations %}

{% set form = hookable_metadata.context.form %}

<div class="tab-pane fade {% if hookable_metadata.configuration.active|default(false) %}show active{% endif %}" id="taxon-tab-general" role="tabpanel" aria-labelledby="taxon-tab-general-button" tabindex="0">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.general'|trans }}
            </h2>
        </div>
        <div class="card-body">
            {# The Sylius hooks of the form, so that what the application adds to them still renders. #}
            {% hook 'general' with { form } %}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.translations'|trans }}
            </h2>
        </div>
        <div>
            {{ translations.with_hook(form.translations, hookable_metadata.prefixes, null, { accordion_id: 'taxon-translations', accordion_flush: true }) }}
        </div>
    </div>
</div>
