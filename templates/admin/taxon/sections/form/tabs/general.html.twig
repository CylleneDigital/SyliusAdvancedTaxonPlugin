{% import '@SyliusAdmin/shared/helper/translations.html.twig' as translations %}

{% set form = hookable_metadata.context.form %}

<div class="tab-pane fade {% if hookable_metadata.configuration.active|default(false) %}show active{% endif %}" id="taxon-tab-general" role="tabpanel" tabindex="0">
    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.general'|trans }}
            </h2>
        </div>
        <div class="card-body">
            {{ form_row(form.code) }}
            {{ form_row(form.parent) }}
            {{ form_row(form.enabled) }}
            {{ form_row(form.advancedFiltersEnabled) }}
            {{ form_row(form.includeChildrenProducts) }}
        </div>
    </div>

    <div class="card mb-3">
        <div class="card-header">
            <h2 class="card-title">
                {{ 'sylius.ui.translations'|trans }}
            </h2>
        </div>
        <div>
            {{ translations.default(form.translations, null, { accordion_id: 'taxon-translations', accordion_flush: true }) }}
        </div>
    </div>
</div>
