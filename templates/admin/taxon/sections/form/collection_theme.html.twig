{% extends '@SyliusAdmin/shared/form_theme.html.twig' %}

{% import '@SyliusAdmin/shared/helper/translations.html.twig' as sylius_translations %}

{% block collection_widget -%}
    {% from '@SyliusResource/Macros/notification.html.twig' import error %}
    {% import _self as self %}
    {% set attr = attr|merge({'class': attr.class|default ~ ' controls collection-widget'}) %}

    {% apply spaceless %}
        <div data-form-type="collection" data-controller="at-admin-form-collection" {{ block('widget_container_attributes') }}
            {% if prototype is defined and allow_add %}
                data-prototype='{{ self.collection_item(prototype, allow_delete, button_delete_label, prototype.vars.name)|e }}'
                data-prototype-name='{{ prototype.vars.name }}'
            {%- endif -%}
        >
            {{ error(form.vars.errors) }}

            {% if prototypes|default is iterable %}
                {% for key, subPrototype in prototypes %}
                    <input type="hidden" data-form-prototype="{{ key }}"
                           value="{{ self.collection_item(subPrototype, allow_delete, button_delete_label, subPrototype.vars.name)|e }}"
                           data-subprototype-name="{{ subPrototype.vars.name }}"
                    />
                {% endfor %}
            {% endif %}

            <div data-form-collection="list" class="row g-3">
                {% for child in form %}
                    {{ self.collection_item(child, allow_delete, button_delete_label, loop.index0) }}
                {% endfor %}
            </div>

            {% if prototype is defined and allow_add %}
                <button type="button" class="btn btn-outline-primary mt-2" data-form-collection="add" data-action="at-admin-form-collection#add">
                    {{ button_add_label|trans|default('Ajouter un média') }}
                </button>
            {% endif %}
        </div>
    {% endapply %}
{%- endblock collection_widget %}

{% macro collection_item(form, allow_delete, button_delete_label, index) %}
    {% apply spaceless %}
        {% set existingPath = form.vars.value is defined and form.vars.value is not null and form.vars.value.path is defined and form.vars.value.path is not empty ? form.vars.value.path : null %}

        <div data-form-collection="item" data-form-collection-index="{{ index }}" class="col-12 border rounded p-3 bg-light-subtle">
            {% if existingPath %}
                <div class="d-flex flex-column gap-3 mb-3">
                    <div class="col-12">
                        <img
                            src="{{ existingPath|imagine_filter('sylius_medium') }}"
                            alt="{{ form.vars.name|default('media') }}"
                            class="img-thumbnail at-admin-media-preview"
                        >
                    </div>
                    <div class="col-12">
                        {{ _self.render_media_item_form(form) }}
                    </div>
                </div>
            {% else %}
                {{ _self.render_media_item_form(form) }}
            {% endif %}

            {% if allow_delete %}
                <button type="button" class="btn btn-outline-danger btn-md mt-3" data-form-collection="delete" data-action="at-admin-form-collection#remove">
                    {{ button_delete_label|trans|default('Supprimer') }}
                </button>
            {% endif %}
        </div>
    {% endapply %}
{% endmacro %}

{% macro render_media_item_form(form) %}
    {% import '@SyliusAdmin/shared/helper/translations.html.twig' as sylius_translations %}

    {% if form.translations is defined %}
        {{ form_row(form.url) }}
        {{ form_row(form.file) }}
        {{ form_row(form.position) }}
        {% if form.showCardText is defined %}
            {{ form_row(form.showCardText) }}
        {% endif %}

        <div class="mt-3">
            <h4 class="h5 mb-2">{{ 'sylius.ui.translations'|trans }}</h4>
            <div class="accordion accordion-flush" id="media-translations-{{ form.vars.id }}">
                {% for locale, translationForm in form.translations %}
                    <div class="accordion-item">
                        {{ sylius_translations.accordion_header(locale, 'media-translations-' ~ form.vars.id, false) }}
                        <div id="translation-media-translations-{{ form.vars.id }}-{{ locale }}" class="accordion-collapse collapse" data-bs-parent="#media-translations-{{ form.vars.id }}">
                            <div class="accordion-body">
                                {% for field in translationForm %}
                                    {{ form_row(field) }}
                                {% endfor %}
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    {% else %}
        {{ form_widget(form) }}
    {% endif %}
{% endmacro %}
