{% set taxon = hookable_metadata.context.taxon|default(advanced_taxon_taxon_from_request()) %}
{% set zoneMedia = taxon is not null and taxon.images is defined ? taxon.images|filter(image => image.type == 'bottom' and image.path) : [] %}

{% if taxon is not null and not taxon.isUniverse and zoneMedia|length > 0 %}
    <div class="mt-4">
        {% include '@CylleneDigitalSyliusAdvancedTaxonPlugin/shop/product/index/content/body/media/zone.html.twig' with {
            taxon: taxon,
            zone: 'bottom',
            displayMode: taxon.mediaDisplayModeBottom|default('stacked'),
        } %}
    </div>
{% endif %}
