{% set mediaUrl = media.path starts with 'http://' or media.path starts with 'https://' ? media.path : asset('media/image/' ~ media.path) %}
{% set mediaTitle = media.titleForLocale(app.request.locale|default(null))|default(taxon.name) %}
{% set mediaDescription = media.descriptionForLocale(app.request.locale|default(null)) %}
{% set mediaHref = advanced_taxon_media_href(media.url) %}

<article class="card mb-3" {{ sylius_test_html_attribute('media-product-list-item', mediaTitle) }}>
    <div class="card-body">
        <div class="row g-3 align-items-center">
            <div class="col-12 col-md-3 col-lg-2">
                {% if mediaHref %}
                    <a class="d-block overflow-hidden bg-light rounded-3 at-product-card-visual-3x4" href="{{ mediaHref }}">
                        <img src="{{ mediaUrl }}" alt="{{ mediaDescription ?? mediaTitle }}" class="w-100 h-100 object-fit-cover" loading="lazy">
                    </a>
                {% else %}
                    <div class="d-block overflow-hidden bg-light rounded-3 at-product-card-visual-3x4">
                        <img src="{{ mediaUrl }}" alt="{{ mediaDescription ?? mediaTitle }}" class="w-100 h-100 object-fit-cover" loading="lazy">
                    </div>
                {% endif %}
            </div>
            <div class="col-12 col-md-9 col-lg-10">
                <h3 class="h5 mb-1">{{ mediaTitle }}</h3>
                {% if mediaDescription is not empty %}
                    <p class="text-muted mb-0">{{ mediaDescription|striptags|slice(0, 180) }}{% if mediaDescription|length > 180 %}...{% endif %}</p>
                {% endif %}
            </div>
        </div>
    </div>
</article>
