<div class="mb-4{% if universeData.titleBackgroundEnabled %} at-universe-intro-card{% endif %}" style="--at-universe-color: {{ universeData.universeAccentColor }};">
    {% if universeData.universePageTitle is not empty %}
        <h1 class="h2 mb-3" {{ sylius_test_html_attribute('universe-title') }}>{{ universeData.universePageTitle }}</h1>
    {% endif %}
    {% if universeData.universePageDescription is not empty %}
        <p class="mb-0">{{ universeData.universePageDescription }}</p>
    {% endif %}
</div>
