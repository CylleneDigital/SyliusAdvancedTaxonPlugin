{% set taxons = hookable_metadata.context.taxons %}
{% set megaMenuEnabled = sylius.channel is defined and sylius.channel.hasMegaMenu %}

{% for taxon in taxons %}
    {% if taxon.enabledChildren|length > 0 %}
        <div class="nav-item dropdown{{ megaMenuEnabled ? ' advanced-taxon-mega-root' : '' }}" {{ sylius_test_html_attribute('menu-item', taxon.name) }}>
            {% hook 'item#dropdown' with { taxon } %}
        </div>
    {% else %}
        {% hook 'item#link' with { taxon } %}
    {% endif %}
{% endfor %}
