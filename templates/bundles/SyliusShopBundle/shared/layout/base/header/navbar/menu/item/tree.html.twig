{% set taxon = taxon|default(null) %}

{% if taxon is not null %}
    {% set children = advanced_taxon_ordered_children(taxon) %}

    {% if children is not empty %}
        <div class="dropend advanced-taxon-dropdown-submenu">
            <div class="dropdown-item d-flex align-items-center justify-content-between gap-2 pe-2">
                <a
                    class="flex-grow-1 text-decoration-none advanced-taxon-header-link"
                    href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}"
                    title="{{ taxon.name|e('html_attr') }}"
                    {{ sylius_test_html_attribute('menu-item', taxon.name) }}
                >
                    {% if taxon.showCustomizationInMenu %}
                        {% include '@CylleneDigitalSyliusAdvancedTaxonPlugin/components/advanced_taxon/taxon_label.html.twig' with {
                            taxon: taxon,
                            iconSize: 18,
                            wrapperClass: 'd-inline-flex align-items-center gap-2',
                            showCustomization: true
                        } only %}
                    {% else %}
                        <span class="d-inline-flex align-items-center gap-2 text-body">{{ taxon.name }}</span>
                    {% endif %}
                </a>

                <span class="advanced-taxon-submenu-indicator flex-shrink-0" aria-hidden="true">
                    {{ ux_icon('tabler:chevron-right', { class: 'icon icon-sm' }) }}
                </span>
            </div>

            <div class="dropdown-menu advanced-taxon-dropdown-submenu-menu">
                {% for child_taxon in children %}
                    {% include '@CylleneDigitalSyliusAdvancedTaxonPlugin/bundles/SyliusShopBundle/shared/layout/base/header/navbar/menu/item/tree.html.twig' with { taxon: child_taxon } only %}
                {% endfor %}
            </div>
        </div>
    {% else %}
        <a
            class="dropdown-item d-flex align-items-center gap-2"
            href="{{ path('sylius_shop_product_index', {'slug': taxon.slug, '_locale': taxon.translation.locale}) }}"
            title="{{ taxon.name|e('html_attr') }}"
            {{ sylius_test_html_attribute('menu-item', taxon.name) }}
        >
            {% if taxon.showCustomizationInMenu %}
                {% include '@CylleneDigitalSyliusAdvancedTaxonPlugin/components/advanced_taxon/taxon_label.html.twig' with {
                    taxon: taxon,
                    iconSize: 18,
                    wrapperClass: 'd-inline-flex align-items-center gap-2',
                    showCustomization: true,
                } only %}
            {% else %}
                <span class="d-inline-flex align-items-center gap-2 text-body">{{ taxon.name }}</span>
            {% endif %}
        </a>
    {% endif %}
{% endif %}