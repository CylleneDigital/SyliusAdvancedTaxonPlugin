<?xml version="1.0" encoding="UTF-8" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <!--
        Behat specific services.

        This file is imported by tests/TestApplication/config/services_test.php when the Symfony
        kernel runs in the "test" environment. Declare here the services used by Behat contexts.
    -->
    <services>
        <!-- Behat resolves contexts from the container, so they have to be public. -->
        <defaults public="true" />

        <service id="cyllene_digital_sylius_advanced_taxon.behat.context.ui.admin.managing_advanced_taxon"
                 class="Tests\CylleneDigital\SyliusAdvancedTaxonPlugin\Behat\Context\Ui\Admin\ManagingAdvancedTaxonContext">
            <argument type="service" id="sylius.repository.taxon"/>
            <argument type="service" id="CylleneDigital\SyliusAdvancedTaxonPlugin\Service\TaxonIconUploader"/>
            <argument type="string">%kernel.project_dir%</argument>
        </service>

        <service id="cyllene_digital_sylius_advanced_taxon.behat.context.conditional.managing_conditional_taxons"
                 class="Tests\CylleneDigital\SyliusAdvancedTaxonPlugin\Behat\Context\Conditional\ManagingConditionalTaxonsContext">
            <argument type="service" id="doctrine.orm.default_entity_manager"/>
            <argument type="service" id="sylius.factory.taxon"/>
            <argument type="service" id="sylius.repository.taxon"/>
            <argument type="service" id="sylius.factory.product"/>
            <argument type="service" id="sylius.repository.product"/>
            <argument type="service" id="sylius.repository.channel"/>
            <argument type="service" id="kernel"/>
            <argument type="string">%sylius.model.product_taxon.class%</argument>
        </service>
    </services>
</container>
