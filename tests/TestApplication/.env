DATABASE_URL=mysql://root:root@mariadb/cyllene_digital_sylius_advanced_taxon_plugin_%kernel.environment%?serverVersion=5.7

# Server version advertised to Doctrine DBAL (see config/packages/doctrine.yaml).
# Must stay a MySQL version: Sylius core migrations only run on the MySQL platform.
DATABASE_SERVER_VERSION=5.7

BEHAT_BASE_URL="http://127.0.0.1:8080/"

SYLIUS_TEST_APP_BUNDLES_PATH="tests/TestApplication/config/bundles.php"
SYLIUS_TEST_APP_CONFIGS_TO_IMPORT="@CylleneDigitalSyliusAdvancedTaxonPlugin/tests/TestApplication/config/config.yaml"
SYLIUS_TEST_APP_ROUTES_TO_IMPORT="@CylleneDigitalSyliusAdvancedTaxonPlugin/tests/TestApplication/config/routes.yaml"
